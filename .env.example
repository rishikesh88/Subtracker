# Copy to .env and fill in. Never commit the filled-in file.

# --- Core ---------------------------------------------------------------
# Neon pooled connection string. Used by the app (neon-http) and by the
# session store (connect-pg-simple over TCP), so it must be the pooled endpoint.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Signing key for session cookies. Required in production; generate with
# `openssl rand -base64 32`.
SESSION_SECRET=
# Public origin the app is served from, no trailing slash. Every OAuth redirect
# URI is built from this. Required in production.
APP_BASE_URL=http://localhost:5000
# Port to listen on. The platform usually injects this.
PORT=5000
# development | production
NODE_ENV=development

# --- Google (sign-in + Gmail mailbox access, one OAuth client) -----------
# Register both redirect URIs on this client:
#   $APP_BASE_URL/api/auth/google-login/callback  (sign-in)
#   $APP_BASE_URL/api/auth/google/callback        (Gmail connect)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional. Overrides the Gmail connect redirect URI only.
GOOGLE_REDIRECT_URI=

# --- Microsoft: Outlook mailbox access ----------------------------------
# Redirect URI: $APP_BASE_URL/api/auth/outlook/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Optional. Overrides the Outlook connect redirect URI only.
MICROSOFT_REDIRECT_URI=

# --- Microsoft: user sign-in (separate app registration) -----------------
# Redirect URI: $APP_BASE_URL/api/auth/microsoft-login/callback
MICROSOFT_AUTH_CLIENT_ID=
MICROSOFT_AUTH_CLIENT_SECRET=
# Directory to authenticate against. "common" allows any Microsoft account.
MICROSOFT_AUTH_TENANT_ID=common

# --- AI -----------------------------------------------------------------
# Gemini API key, used for subscription detection.
GEMINI_API_KEY=

# --- Email --------------------------------------------------------------
# Resend API key. The verloq.co sending domain must be verified with DKIM/SPF.
RESEND_API_KEY=

# --- Object storage -----------------------------------------------------
# Root path for private objects, as /<bucket-name>/<prefix>.
PRIVATE_OBJECT_DIR=/your-bucket-name/private
# Full service account key as inline JSON on one line. Omit locally to fall
# back to Application Default Credentials.
GOOGLE_APPLICATION_CREDENTIALS_JSON=
# Google Cloud project id. Defaults to project_id from the key above.
GCS_PROJECT_ID=

# --- Token encryption -------------------------------------------------------
# Encrypts Gmail and Outlook OAuth tokens before they are written to the
# database, so a leaked connection string or a stolen backup is not enough to
# read anyone's mailbox.
#
# REQUIRED. Without it, connecting a mailbox and every sync will fail with a
# clear error. The server still boots and sign-in still works, so a
# misconfigured deploy is obvious rather than silently storing plaintext.
#
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Treat it like a database password. If it is lost, every stored token becomes
# unreadable and every user has to reconnect their mailbox. Changing it has the
# same effect, so rotate only with a re-encryption pass.
TOKEN_ENCRYPTION_KEY=

# --- Brand logos --------------------------------------------------------
# Brandfetch Logo Link client id, used to show a service's logo in the app.
# Publishable by design: it travels in the image URL and is visible to anyone
# using the app, so it is compiled into the client bundle. This is NOT the
# Brandfetch API key -- that one is secret, is for the Brand API, and must
# never be given a VITE_ prefix or it would ship to the browser.
#
# Unset is a supported state: every logo becomes the service's initial in a
# tile. Nothing breaks -- that is what a deploy looks like before this is set.
#
# Substituted at BUILD time, not read at runtime, so changing it needs a
# rebuild rather than a restart.
VITE_BRANDFETCH_CLIENT_ID=
