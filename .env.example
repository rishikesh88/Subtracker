# Copy to .env and fill in. Never commit the filled-in file.

# --- Core ---------------------------------------------------------------
# Neon pooled connection string. Used by the app (neon-http) and by the
# session store (connect-pg-simple over TCP), so it must be the pooled endpoint.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Signing key for session cookies. Required in production; generate with
# `openssl rand -base64 32`.
SESSION_SECRET=
# Public origin the app is served from, no trailing slash. Every OAuth redirect
# URI is built from this. Required in production.
APP_BASE_URL=http://localhost:5000
# Port to listen on. The platform usually injects this.
PORT=5000
# development | production
NODE_ENV=development

# --- Google (sign-in + Gmail mailbox access, one OAuth client) -----------
# Register both redirect URIs on this client:
#   $APP_BASE_URL/api/auth/google-login/callback  (sign-in)
#   $APP_BASE_URL/api/auth/google/callback        (Gmail connect)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional. Overrides the Gmail connect redirect URI only.
GOOGLE_REDIRECT_URI=

# --- Microsoft: Outlook mailbox access ----------------------------------
# Redirect URI: $APP_BASE_URL/api/auth/outlook/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Optional. Overrides the Outlook connect redirect URI only.
MICROSOFT_REDIRECT_URI=

# --- Microsoft: user sign-in (separate app registration) -----------------
# Redirect URI: $APP_BASE_URL/api/auth/microsoft-login/callback
MICROSOFT_AUTH_CLIENT_ID=
MICROSOFT_AUTH_CLIENT_SECRET=
# Directory to authenticate against. "common" allows any Microsoft account.
MICROSOFT_AUTH_TENANT_ID=common

# --- AI -----------------------------------------------------------------
# Gemini API key, used for subscription detection.
GEMINI_API_KEY=

# --- Email --------------------------------------------------------------
# Resend API key. The verloq.co sending domain must be verified with DKIM/SPF.
RESEND_API_KEY=

# --- Object storage -----------------------------------------------------
# Root path for private objects, as /<bucket-name>/<prefix>.
PRIVATE_OBJECT_DIR=/your-bucket-name/private
# Full service account key as inline JSON on one line. Omit locally to fall
# back to Application Default Credentials.
GOOGLE_APPLICATION_CREDENTIALS_JSON=
# Google Cloud project id. Defaults to project_id from the key above.
GCS_PROJECT_ID=
